# FarmXpert AI backend. Copy to .env; every key is optional for local work.

# Shared secret with the Node backend (its INTERNAL_API_KEY). When set, every
# route except liveness and the docs requires it in the x-internal-key header.
INTERNAL_API_KEY=

# The Node backend, used by the market agent to read stored mandi prices.
BACKEND_BASE_URL=http://localhost:4000

# Knowledge index only (pgvector). Same database as the Node backend, whose
# migrations create the table. Unset = retrieval uses the curated bundle only.
DATABASE_URL=
AI_DB_POOL_SIZE=3

# ── Language model (any OpenAI-compatible provider) ─────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Understanding is a short classification: use the smallest, fastest model.
# The answer is what the farmer reads or hears: use the quality model.
# Check the exact model names your account offers.
LLM_MODEL_UNDERSTAND=gpt-5-nano
LLM_MODEL_ANSWER=gpt-5-mini
# One retry on this model when the answer model fails or is too slow.
LLM_MODEL_FALLBACK=
# Reasoning effort for GPT-5 / o-series: minimal | low | medium | high.
# Lower is faster; the agents have already done the reasoning.
LLM_REASONING_UNDERSTAND=minimal
LLM_REASONING_ANSWER=low
LLM_TIMEOUT_UNDERSTAND_S=6
LLM_TIMEOUT_ANSWER_S=20

# Embeddings for the knowledge index. text-embedding-3 is multilingual, so a
# Hindi or Tamil question finds English handbook text. Changing the model
# needs POST /orchestrator/knowledge/reindex (old vectors are never mixed in).
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1024
EMBED_QUERY_CACHE_SIZE=2048

# ── Voice ───────────────────────────────────────────────────────────────────
# Defaults to the LLM endpoint and key above.
SPEECH_BASE_URL=
SPEECH_API_KEY=
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Per-language voices, e.g. {"hi":"alloy","ta":"nova"}
TTS_VOICES=
# mp3 plays on every phone; opus is smaller but not on older iPhones.
TTS_FORMAT=mp3
VOICE_MAX_BYTES=2097152
VOICE_MAX_SECONDS=60
SPEECH_TIMEOUT_S=15

# Legacy NVIDIA settings still work if the LLM_* ones are unset:
# NVIDIA_API_KEY=  NVIDIA_BASE_URL=  NVIDIA_MODEL=  NVIDIA_EMBED_MODEL=

OPENWEATHER_API_KEY=
AI_DEBUG=false
