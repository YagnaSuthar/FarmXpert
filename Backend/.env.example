# FarmXpert backend (Node.js). Copy to .env and fill in.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 14+ with PostGIS and pgvector. This service owns the schema.
DATABASE_URL=postgres://user:password@host:5432/farmxpert
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
# "require" for managed Postgres (Neon, RDS, Supabase); "disable" for local.
# disable for local PostgreSQL; require (the production default) for hosted databases
DB_SSL=disable

# The AI backend (FastAPI). Internal only - never exposed to the browser.
AI_BACKEND_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=35000
# Shared secret; the AI backend rejects calls without it when set there too.
INTERNAL_API_KEY=change-me-long-random-string

# Protects /admin endpoints (lifecycle run, knowledge reindex).
ADMIN_API_KEY=change-me-another-long-random-string

# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Mandi prices from data.gov.in (Agmarknet daily prices resource).
DATA_GOV_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MANDI_COMMODITIES=Wheat,Rice,Tomato,Onion,Potato,Cotton,Groundnut
MANDI_CRON=15 * * * *

# Blynk sensor cloud.
BLYNK_BASE_URL=https://blynk.cloud/external/api/get

# Cold storage for archived months. file:// today; s3:// needs an ArchiveStore.
ARCHIVE_URI=file://./archive
LIFECYCLE_CRON=30 2 * * *

# Run background jobs in this process. Set false on extra API replicas; jobs
# also take a database lock, so two instances never run the same job at once.
JOBS_ENABLED=true

# Token usage and quotas
# Per farmer per local day across all models; 0 = unlimited. Override per user
# with PUT /api/v1/admin/users/:id/token-limit.
TOKEN_DAILY_LIMIT=60000
TOKEN_DAY_TIMEZONE=Asia/Kolkata
# Price per 1M tokens, recorded with the usage when it happens. Unpriced models cost 0.
# TOKEN_PRICES={"meta/llama-3.3-70b-instruct":{"input":0.0,"output":0.0},"nvidia/nv-embedqa-e5-v5":{"input":0.0,"output":0}}
TOKEN_PRICE_CURRENCY=USD
TOKEN_USAGE_RETENTION_DAYS=730

# Streaming and voice
# A streamed (or spoken) answer runs longer than a JSON one.
AI_STREAM_TIMEOUT_MS=90000
VOICE_MAX_BYTES=2097152
VOICE_MAX_SECONDS=60
# Speech seconds per farmer per local day, on top of the token allowance. 0 = unlimited.
VOICE_DAILY_SECONDS=900
# Burst guard per user (or IP) per minute. 0 disables.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VOICE_PER_MIN=8
# Speech prices go in TOKEN_PRICES too: {"gpt-4o-transcribe":{"per_minute":0.006},
#   "gpt-4o-mini-tts":{"per_1m_characters":15}} (check your provider's current prices)
