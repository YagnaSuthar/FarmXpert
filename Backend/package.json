{
  "name": "farmxpert-backend",
  "version": "1.0.0",
  "description": "FarmXpert API: farms, readings, conversations and the database. Calls the AI backend for agent work.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "migrate:status": "node --env-file-if-exists=.env src/db/migrate.js --status",
    "lifecycle": "node --env-file-if-exists=.env src/jobs/storageLifecycle.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-reporter=spec \"test/integration/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1"
  }
}
